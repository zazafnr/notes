{
  "name": "ios-simulator-pc",
  "productName": "iOS-Simulator",
  "version": "1.0.0",
  "description": "iPhone und iPad am PC: echte iOS-Simulatoren auf einem Cloud-Mac, bedient wie ein Gerät",
  "main": "main.js",
  "private": true,
  "license": "UNLICENSED",
  "author": "zazafnr",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --x64",
    "pack:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "de.zazafnr.iossimulator",
    "productName": "iOS-Simulator",
    "artifactName": "iOS-Simulator-${version}-${arch}-${target}.${ext}",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "github.js", "renderer/**", "build/icon.png"],
    "win": {
      "icon": "build/icon.png",
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "iOS-Simulator"
    },
    "portable": { "artifactName": "iOS-Simulator-${version}-portable.exe" }
  }
}
